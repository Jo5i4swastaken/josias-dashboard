# Generate each secret with openssl. See the README.
# Never commit real values. Copy this file to .env.local for local development.

# Encrypts the session cookie. At least 32 characters.
DASHBOARD_SESSION_SECRET=

# 32-byte key for AES-256-GCM encryption of the TOTP secret at rest.
# openssl rand -base64 32
DASHBOARD_ENC_KEY=

# One-time token entered on /setup. Setup refuses to run again after it finishes.
DASHBOARD_SETUP_TOKEN=

# Bearer token for the assistant bot API. Compared in constant time.
DASHBOARD_API_TOKEN=

# Inbox that receives emailed sign-in codes.
# Optional: if unset, codes go to the address saved during /setup.
# If set, this address wins, so you can change inboxes without redoing setup.
DASHBOARD_2FA_EMAIL=

# From address for sign-in codes. Required once an email transport is configured.
EMAIL_FROM=

# Resend (preferred when RESEND_API_KEY is set).
RESEND_API_KEY=

# SMTP fallback, used when RESEND_API_KEY is unset and SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Upstash Redis. Vercel's Upstash integration sets these names.
# Required in production. Local dev falls back to a gitignored file in .data/.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# IANA timezone used for "this week" and deadline labels. Defaults to UTC.
DASHBOARD_TIMEZONE=UTC

# Dev only. Directory for the file store. Defaults to ./.data
# DASHBOARD_DATA_DIR=
